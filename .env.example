# Secret used to sign JWTs — set a long random string in real environments
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Neon Postgres — copy the connection string from the Neon dashboard
# (Project > Connection Details). Prefer the POOLED connection string
# (hostname contains "-pooler"). Plain postgresql:// is fine here — it's
# rewritten to postgresql+asyncpg:// automatically, and sslmode=require is
# translated into the asyncpg ssl connect arg.
# Example: postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/mdmis?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/mdmis?sslmode=require

# Comma-separated list of frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional: also allow origins matching this regex, e.g. Vercel preview deployments:
# CORS_ALLOWED_ORIGIN_REGEX=^https://mining-?system-[a-z0-9]+-vivamugisha-9213s-projects\.vercel\.app$

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Used to build invite-acceptance links in emails, e.g. https://app.mdmis.rw
FRONTEND_URL=http://localhost:3000

# Brevo (transactional email) � leave empty in dev; emails (OTP codes,
# invite links) are then printed to the backend console instead of sent.
# Create the key in Brevo > SMTP & API > API Keys. EMAIL_FROM must be a
# sender verified in Brevo (Senders, Domains & Dedicated IPs > Senders).
BREVO_API_KEY=
EMAIL_FROM=no-reply@mdmis.rw
EMAIL_FROM_NAME=MDMIS

OTP_EXPIRE_MINUTES=10
INVITATION_EXPIRE_DAYS=7

# mdmis-ml-service (separate repo). Must match that service's own
# SERVICE_API_KEY.
ML_SERVICE_URL=http://localhost:8100
ML_SERVICE_API_KEY=change-me-to-a-long-random-string

# Organisations whose lab_confirmed zones may train the shared ML model
# (comma-separated organisation UUIDs). Empty = none: any organisation can
# sign up and confirm its own zones, so training data is opt-in per org.
TRAINING_ORG_IDS=

# API docs (/docs, /redoc, /openapi.json): unset = on locally, off when
# DATABASE_URL is a real database. Set true to force them on.
# API_DOCS_ENABLED=
