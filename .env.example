# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Neon Postgres — copy the connection string from the Neon dashboard
# (Project > Connection Details). Prefer the POOLED connection string
# (hostname contains "-pooler") since Django opens/closes connections
# per request. sslmode=require is mandatory for Neon.
# Example: postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/mdmis?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/mdmis?sslmode=require

# Comma-separated list of frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:3000
